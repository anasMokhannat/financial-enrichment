# =========================================================================
# legal-financial-enrichment — environment template
# =========================================================================
# Copy to `.env.local` and fill in the secrets. `.env.local` is gitignored
# by Next.js by default. None of the names below should have the
# `NEXT_PUBLIC_` prefix — they're all server-only.
# =========================================================================


# ── Supabase ─────────────────────────────────────────────────────────────
#
# Project URL: Dashboard → Settings → API → Project URL.
# Service-role key: Dashboard → Settings → API → service_role (secret).
# This key bypasses RLS — keep it server-side only. The Route Handlers
# use it; never expose it via NEXT_PUBLIC_.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...


# ── NBB CBSO (Belgian National Bank financial filings) ────────────────────
#
# Request a subscription key from:
#   https://www.nbb.be/en/central-balance-sheet-office/consultation/web-services
# Base URL is the production endpoint by default — only override for sandbox.

NBB_API_SUBSCRIPTION_KEY=
NBB_API_BASE_URL=https://ws.cbso.nbb.be/authentic

# Some subscription tiers expose deposit data under a different path
# (e.g. `/deposits/...` plural). `{reference}` is substituted at call time.
NBB_DEPOSIT_PATH=/deposit/{reference}/accountingData


# ── OpenAI (commercial-fit analyzer) ──────────────────────────────────────
#
# Used by POST /api/companies/[cbe]/analyze. Optional — the rest of the
# app works without it; the analysis panel just shows "OpenAI not configured".

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# ── Apollo.io (prospect email enrichment) ────────────────────────────────
#
# Used by POST /api/prospects/enrich — the "Find" button on a director's
# card in the Prospects panel calls Apollo's People Match endpoint with
# the director's name + the company name to retrieve a business email.
# Optional — without it, the Find button shows "Apollo not configured".

APOLLO_API_KEY=
APOLLO_API_BASE_URL=https://api.apollo.io


# ── HTTP timeouts (optional) ──────────────────────────────────────────────

# Per-request timeout for upstream calls (NBB, KBO). Default 30s.
HTTP_TIMEOUT_MS=30000


# ── Frontend → backend URL (optional) ─────────────────────────────────────
#
# Empty (or unset) means the frontend calls its own /api/... routes
# same-origin, which is what you want once the Python backend is gone.
# Set this only if you want the dashboard to point at a remote backend
# (e.g. a staging deployment from your local dev).

# NEXT_PUBLIC_API_URL=
