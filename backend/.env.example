# NBB CBSO Authentic Data Query API
# Request access via https://www.nbb.be/en/central-balance-sheet-office/consultation/web-services
NBB_API_BASE_URL=https://ws.cbso.nbb.be/authentic
NBB_API_SUBSCRIPTION_KEY=your-subscription-key-here
# Single deposit endpoint; PDF vs XBRL picked by the Accept header.
NBB_DEPOSIT_PATH=/deposit/{reference}/accountingData

# Optional: override default request timeout (seconds)
HTTP_TIMEOUT=30

# Optional: where to cache downloaded PDFs/JSON
CACHE_DIR=./.cache

# OpenAI (for LLM-based financial extraction; only needed for scripts/compare_extractors.py)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Hard input-token cap for the model. 272000 = current cap; lower it
# if you switch to a smaller-context model (e.g. 128000 for gpt-4o).
OPENAI_MAX_INPUT_TOKENS=128000
# Headroom reserved for the system prompt + completion. The user
# content is truncated so that (system + user) <= max_input - margin.
OPENAI_SAFETY_MARGIN_TOKENS=2000

# Supabase. Get these from Project Settings → API in the Supabase dashboard.
# The service-role key bypasses RLS and must NEVER ship to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
SUPABASE_ANON_KEY=eyJhbGc...
